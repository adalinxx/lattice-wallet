{
  "manifest_version": 3,
  "name": "Selfhold",
  "version": "0.4.0",
  "description": "Non-custodial wallet for Lattice chains. Keys never leave your device; you choose the node.",
  "action": {
    "default_title": "Selfhold",
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "assets/lattice-mark-48.png",
      "128": "assets/lattice-mark-128.png"
    }
  },
  "icons": {
    "48": "assets/lattice-mark-48.png",
    "128": "assets/lattice-mark-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https: http://127.0.0.1:* http://localhost:* http://[::1]:*; object-src 'none'; base-uri 'none'"
  },
  "host_permissions": [
    "https://rpc.lattice.build/*",
    "https://lattice-mainnet-read.fly.dev/*",
    "https://lattice-mainnet-testnet.fly.dev/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "page/inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "page/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
